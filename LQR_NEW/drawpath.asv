function drawpath(t_out, x_states, Vx, vphides_t)
    % t_out: Idővektor (szimulációból)
    % x_states: Állapotmátrix [e1, e1_dot, e2, e2_dot]
    % Vx: Haladási sebesség (m/s)
    % vphides_t: Desired yaw rate (rad/s)

    % Állapotok kinyerése
    e1 = x_states(:, 1);
    e2 = x_states(:, 3);

    % 1. Az út irányának (psi_des) kiszámítása integrálással
    psi_des = cumtrapz(t_out, vphides_t);

    % 2. Az út középvonalának (X_des, Y_des) kiszámítása
    X_des = cumtrapz(t_out, Vx * cos(psi_des));
    Y_des = cumtrapz(t_out, Vx * sin(psi_des));

    % 3. Az autó globális pozíciójának kiszámítása (Rajamani 2.56-2.57)
    X_car = X_des - e1 .* sin(e2 + psi_des);
    Y_car = Y_des + e1 .* cos(e2 + psi_des);

    % Vizualizáció
    figure('Name', 'Globális Pályakövetés', 'Color', 'w');
    plot(X_des, Y_des, 'r-', 'LineWidth', 1.5); hold on;
    plot(X_car, Y_car, 'b', 'LineWidth', 2);
    grid on; axis equal;
    xlabel('X [m]'); ylabel('Y [m]');
    legend('Út középvonala', 'Autó tényleges pályája');
    title('Az autó mozgása a globális koordináta-rendszerben');
end